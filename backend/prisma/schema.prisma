// Prisma schema — Nimbus backend (through Phase 11B: recurring billing & webhooks)
// Run `npm run prisma:migrate` after setting DATABASE_URL in .env,
// then `npm run prisma:seed` to load the default plans (and, if
// ADMIN_SEED_EMAIL/ADMIN_SEED_PASSWORD are set, a bootstrap admin — see
// prisma/seed.ts and the Phase 10 README section).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

// Suspension is enforced at login and refresh (see auth.service.ts) rather
// than on every request — consistent with this backend's existing
// stateless-access-token design (no per-request DB hit, no token
// blacklist). A suspended user's refresh is rejected immediately and their
// sessions are deleted on suspend, so the worst case is whatever's left of
// their current access token's lifetime (15m by default) — see the Phase
// 10 README section for this tradeoff spelled out.
enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model User {
  id           String @id @default(uuid())
  name         String
  email        String @unique
  passwordHash String     @map("password_hash")
  role         Role       @default(USER)
  status       UserStatus @default(ACTIVE)

  // Denormalized pointer to the user's current plan, for cheap reads
  // (dashboard storage limits etc.) without joining through subscriptions.
  // `subscriptions` below is the source of truth / billing history.
  planId String? @map("plan_id")
  plan   Plan?   @relation(fields: [planId], references: [id])

  // Reserved for a future phase — not wired to Nextcloud yet.
  nextcloudUsername String? @map("nextcloud_username")

  // AES-256-GCM ciphertext of a dedicated Nextcloud app password minted
  // specifically for WebDAV file access (see NextcloudService.createUser
  // and nextcloud-agent's user:auth-tokens:add step) — NOT this user's
  // actual login password, and NOT the same value as passwordHash above
  // (which is one-way bcrypt and can never be used to authenticate
  // against anything). This one is reversible by design: the backend
  // needs the plaintext back to make WebDAV requests on the user's
  // behalf. Encrypted at rest with CREDENTIAL_ENCRYPTION_KEY — see
  // utils/encryption.ts.
  nextcloudWebdavPasswordEncrypted String? @map("nextcloud_webdav_password_encrypted")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subscriptions       Subscription[]
  payments            Payment[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model Plan {
  id   String @id @default(uuid())
  name String @unique
  // Storage ceiling in gigabytes (Free=5, Basic=100, Pro=500).
  storageLimit Int     @map("storage_limit")
  price        Decimal @db.Decimal(10, 2)

  users         User[]
  subscriptions Subscription[]
  payments      Payment[]

  @@map("plans")
}

// One row per user, upserted in place rather than accumulating a row per
// billing period — Payment is already the append-only historical ledger
// (see its own header comment), so this only needs to represent "what's
// true right now." @unique on userId (added for Phase 11A) is what makes
// upsert-based plan changes race-safe: two concurrent requests upserting
// the same user's row converge on one another instead of racing to create
// two rows, since Postgres enforces the uniqueness at the DB level, not
// just in application code.
model Subscription {
  id     String             @id @default(uuid())
  userId String             @unique @map("user_id")
  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status SubscriptionStatus @default(ACTIVE)

  planId String @map("plan_id")
  plan   Plan   @relation(fields: [planId], references: [id])

  renewalDate DateTime @map("renewal_date")

  // Set only once the Nextcloud quota update for this plan actually
  // succeeds (see payment.service.ts's applyPlanChange) — left null if
  // that call fails after the plan change was already committed. Acted on
  // by reconciliation.service.ts (Phase 11B), which retries the sync for
  // every subscription still carrying a null here.
  quotaSyncedAt DateTime? @map("quota_synced_at")

  // Phase 11B ("cancel at period end"): true means the user asked to
  // cancel but keeps their current plan/quota until `renewalDate`
  // arrives, at which point reconciliation.service.ts's sweep reverts them
  // to Free (see payment.service.ts's cancelSubscription for the
  // immediate-effect alternative, which never touches this flag at all
  // since there's nothing left to schedule). Reset to false by
  // applyPlanChange on every plan change — any previously scheduled
  // cancellation is implicitly abandoned the moment the user buys/switches
  // to a plan again.
  cancelAtPeriodEnd Boolean @default(false) @map("cancel_at_period_end")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Every payment that created or renewed this subscription — kept even if
  // a payment's own subscriptionId later goes null (see Payment.subscription).
  payments Payment[]

  @@map("subscriptions")
}

// Phase 11B: one row per Razorpay webhook delivery, keyed by a hash of the
// exact raw request body rather than trusting any single field inside the
// payload itself to be a reliable unique event id across every event type
// Razorpay sends. This is what makes webhook processing fully idempotent
// at the transport level — see webhook.service.ts — layered on top of the
// fact that the actual handlers underneath (paymentService.confirmPayment,
// paymentRepository.markRefunded, etc.) are themselves idempotent by
// construction, the same way verify-payment already was in Phase 11A.
model WebhookEvent {
  id        String             @id
  eventType String             @map("event_type")
  status    WebhookEventStatus @default(RECEIVED)
  // The full decoded payload, kept for audit/reconciliation/debugging —
  // Json rather than a typed column since the shape varies per eventType
  // and Razorpay can (and does) add fields over time without notice.
  payload Json

  error       String?
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([eventType])
  @@map("webhook_events")
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
}

model Payment {
  id     String        @id @default(uuid())
  userId String        @map("user_id")
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount Decimal       @db.Decimal(10, 2)
  status PaymentStatus @default(PENDING)
  // Free-text rather than an enum — new providers (Stripe, Razorpay, PayPal...)
  // shouldn't require a schema migration to add.
  provider String

  // The subscription this payment created or renewed. Optional: a payment
  // can exist (e.g. a failed/pending charge) before any subscription is
  // created from it, and SetNull rather than Cascade on delete means a
  // payment record survives even if its subscription is later removed —
  // billing history should outlive the subscription row it's tied to.
  subscriptionId String?       @map("subscription_id")
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  // Which plan this payment was FOR — set at order-creation time (Phase
  // 11A), before subscriptionId can be known (the subscription doesn't
  // get created/updated until the payment is actually verified). SetNull
  // for the same "billing history outlives the thing it's tied to" reason
  // subscriptionId does.
  planId String? @map("plan_id")
  plan   Plan?   @relation(fields: [planId], references: [id], onDelete: SetNull)

  // The payment gateway's own order/intent identifier — Razorpay Order ID
  // in this app's case (see RazorpayService.ts). Known immediately at
  // order-creation, unlike providerPaymentId below. @unique both enforces
  // "one Payment row per gateway order" at the DB level and is what
  // verify-payment looks this row up by — it never creates a new Payment
  // row itself, only ever updates the one create-order already made.
  providerOrderId String? @unique @map("provider_order_id")

  // The payment gateway's own identifier for this charge — Razorpay
  // Payment ID, Stripe PaymentIntent ID, PayPal Transaction ID, etc.
  // Nullable because it isn't known until the gateway responds, and free
  // text for the same reason `provider` is: format varies per gateway.
  // @unique (added Phase 11A) is a second, DB-level line of defense
  // against ever recording the same gateway charge twice, on top of the
  // application-level idempotency check in payment.service.ts.
  providerPaymentId String? @unique @map("provider_payment_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([subscriptionId])
  @@index([planId])
  @@map("payments")
}

// One row per active login session. Login/refresh create a row; logout or
// refresh-rotation deletes it — so "row exists and isn't expired" IS the
// validity check, no separate revoked flag needed.
model Session {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // SHA-256 hash of the refresh token, never the raw value — a leaked DB
  // row can't be replayed as a live session.
  refreshToken String   @unique @map("refresh_token")
  expiresAt    DateTime @map("expires_at")

  // Added for Phase 10's admin "active sessions" view — captured once at
  // issueTokenPair() time (see auth.service.ts), never updated afterward.
  // Best-effort only: both come straight from request headers, so a
  // client can send whatever User-Agent it wants. Good enough to show an
  // admin roughly what/where a session is, not a security control.
  createdAt DateTime @default(now()) @map("created_at")
  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address")

  @@index([userId])
  @@map("sessions")
}

// Issued by POST /forgot-password. Only the hash is stored — same pattern
// as Session — so a leaked DB row can't be used to reset someone's password.
// `usedAt` prevents a token being replayed after a successful reset.
model PasswordResetToken {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}
