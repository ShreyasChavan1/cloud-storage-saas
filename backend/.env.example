# Server
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL="postgresql://nimbus:nimbus@localhost:5432/nimbus?schema=public"

# JWT
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PASSWORD_RESET_TOKEN_EXPIRES_IN=30m

# bcrypt
BCRYPT_SALT_ROUNDS=12

# Nextcloud is provisioned via a small standalone agent (see
# ../nextcloud-agent) running ON the Nextcloud server — NOT the OCS HTTP
# API (currently-open Nextcloud bug, server#51637, rejects sensitive
# requests even with a valid app password) and NOT SSH from this machine
# (no private key needed here). See README > Nextcloud integration.
NEXTCLOUD_AGENT_URL=http://141.148.216.121:4100
# Must exactly match AGENT_TOKEN in nextcloud-agent's own .env.
NEXTCLOUD_AGENT_TOKEN=replace-with-the-same-token-set-in-the-agent

# WebDAV base URL — NOT a secret, same host:port as Nextcloud's own web UI.
# Used directly by this backend for file operations; every request
# authenticates as the specific target user via their own app password
# (see Phase 6 in README), never an admin credential.
NEXTCLOUD_URL=http://141.148.216.121:8080

# AES-256-GCM key (32 bytes, hex-encoded = 64 hex chars) encrypting each
# user's WebDAV app password at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Back this up like any other production secret — losing it orphans every
# stored WebDAV credential (existing users would need to be re-provisioned).
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-generated-64-char-hex-string

# Logging
LOG_LEVEL=info

# Razorpay (Phase 11A). RAZORPAY_KEY_ID is not secret — it's the same
# public key id a Razorpay checkout widget would need client-side — but
# RAZORPAY_KEY_SECRET must be treated like any other production secret;
# see RazorpayService.ts for the only place it's read.
RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace-with-your-razorpay-key-secret
RAZORPAY_CURRENCY=INR

# Phase 11B — set when configuring the webhook in the Razorpay dashboard
# (Settings > Webhooks). Deliberately a DIFFERENT secret from
# RAZORPAY_KEY_SECRET above; see RazorpayService.verifyWebhookSignature.
# Subscribe at least: payment.captured, payment.failed, refund.created,
# refund.processed.
RAZORPAY_WEBHOOK_SECRET=replace-with-your-razorpay-webhook-secret

# Optional (Phase 10): seeds one ADMIN-role account the first time
# `npm run prisma:seed` runs, via the same account-provisioning pipeline
# as a normal registration (so it also gets a real, working Nextcloud
# storage account — needs the Nextcloud vars above to be set and
# reachable). Leave both unset to skip this entirely; there is no other
# way to reach the admin dashboard on a brand new database otherwise,
# since self-registration always creates role USER.

# ADMIN_SEED_NAME=Admin
