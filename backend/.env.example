# ---- Server -----------------------------------------------------------------
# REQUIRED, no default: development | test | production. The app refuses to
# start without it (a forgotten value used to silently mean "development").
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Reverse-proxy hops in front of the app (Railway/Render/nginx = 1, none = 0).
# Wrong values break rate limiting: too low = all users share one bucket,
# too high = clients can spoof X-Forwarded-For.
TRUST_PROXY_HOPS=1
GLOBAL_RATE_LIMIT_PER_15MIN=1500

# ---- Database (NEVER commit a real connection string) -----------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# ---- JWT --------------------------------------------------------------------
# Production needs >=32 random chars, two DIFFERENT values, no placeholders:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Nimbus <no-reply@your-domain.example>"
CLIENT_EMAIL_VERIFICATION_URL=http://localhost:5173/verify-email
CLIENT_RESET_URL=http://localhost:5173/reset-password
PASSWORD_RESET_TOKEN_EXPIRES_IN=30m
EMAIL_VERIFICATION_TOKEN_EXPIRES_IN=24h

# ---- Passwords --------------------------------------------------------------
BCRYPT_SALT_ROUNDS=12

# ---- Nextcloud --------------------------------------------------------------
NEXTCLOUD_AGENT_URL=http://127.0.0.1:4100
NEXTCLOUD_AGENT_TOKEN=
NEXTCLOUD_URL=http://127.0.0.1:8080
# 64 hex chars:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=

# ---- Logging ----------------------------------------------------------------
LOG_LEVEL=info

# Razorpay and IDrive e2 variables: see src/config/env.ts for the full list.
