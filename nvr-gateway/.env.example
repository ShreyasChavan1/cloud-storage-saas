# Customer gateway bootstrap. The installer writes these values automatically.
# NVR credentials, channels and intervals are configured in Nimbus after enrollment.
NIMBUS_API_URL=https://api.example.com
NIMBUS_ENROLLMENT_CODE=NVR-ONE-TIME-CODE
# Optional override for the local durable queue.
SPOOL_DIR=/var/lib/nimbus-nvr-gateway/spool
